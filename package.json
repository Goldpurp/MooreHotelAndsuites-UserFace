{
  "name": "moore-hotel-and-suites",
  "version": "1.2.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "A luxury hospitality guest platform for Moore Hotels & Suites",
  "type": "module",
  "scripts": {
    "dev": "yarn dev:local",
    "dev:local": "vite --mode localhost",
    "local": "yarn build:local && vite preview --mode localhost",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:high": "node scripts/audit-high.mjs",
    "build": "yarn build:production",
    "build:production": "tsc --noEmit && vite build --mode production",
    "build:local": "tsc --noEmit && vite build --mode localhost",
    "check:profiles": "tsc --noEmit && vite build --mode localhost && vite build --mode production",
    "check:local": "node scripts/check-environment.mjs local",
    "check:production": "node scripts/check-environment.mjs production",
    "preview": "vite preview --mode production",
    "preview:local": "vite preview --mode localhost"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.12",
    "tailwindcss": "3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.4.3"
  },
  "resolutions": {
    "@babel/core": "7.29.6",
    "dompurify": "3.4.12",
    "postcss": "8.5.12",
    "rollup": "^4.59.0"
  }
}
